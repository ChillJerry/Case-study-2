{
  "id": null,
  "uid": "innovatech-security-logs",
  "title": "Innovatech | Security Log Monitoring",
  "description": "Hybrid-cloud security monitoring using nftables, Linux logs, Grafana Alloy and Loki.",
  "tags": [
    "innovatech",
    "security",
    "loki",
    "firewall",
    "authentication",
    "hybrid-cloud"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "01 | Security Operations Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Firewall Drop Events",
      "description": "Firewall log entries in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"onprem-firewall\"} |= \"INNOVATECH_FW_DROP\" [$__range])) or vector(0)",
          "queryType": "instant",
          "instant": true,
          "maxLines": 100
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      }
    },
    {
