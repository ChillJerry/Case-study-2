
logging {
  level = "info"
  format = "logfmt"
}

loki.source.file "monitoring_logs" {
  targets = [
    {
      __path__ = "/host/var/log/syslog",
      job      = "aws-monitoring",
      host     = "cs2-aws-monitoring",
    },
    {
      __path__ = "/host/var/log/auth.log",
      job      = "aws-monitoring-auth",
      host     = "cs2-aws-monitoring",
    },
  ]

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
