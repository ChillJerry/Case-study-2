                                           "expr":  "sum by (instance) (rate(node_disk_written_bytes_total{device=~\"(nvme[0-9]+n[0-9]+|sd[a-z]+|vd[a-z]+|xvd[a-z]+)\"}[5m]))"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  42
