    {
      "id": 7,
      "type": "timeseries",
      "title": "Blocked Traffic Over Time",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"onprem-firewall\"} |= \"INNOVATECH_FW_DROP\" [$__interval]))",
          "queryType": "range",
          "instant": false,
          "maxLines": 100,
          "legendFormat": "Firewall drops"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 55,
            "showPoints": "never",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Blocked Traffic by Source IP",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (src_ip) (count_over_time({job=\"onprem-firewall\"} |= \"INNOVATECH_FW_DROP\" | regexp \"SRC=(?P<src_ip>[0-9.]+)\" [$__interval])))",
          "queryType": "range",
          "instant": false,
          "maxLines": 100,
          "legendFormat": "{{src_ip}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
