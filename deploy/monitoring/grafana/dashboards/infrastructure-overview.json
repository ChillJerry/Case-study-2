{
    "uid":  "innovatech-infra",
    "title":  "Innovatech Infrastructure Overview",
    "tags":  [
                 "innovatech",
                 "infrastructure",
                 "monitoring"
             ],
    "timezone":  "browser",
    "schemaVersion":  41,
    "version":  7,
    "refresh":  "30s",
    "time":  {
                 "from":  "now-1h",
                 "to":  "now"
             },
    "panels":  [
                   {
                       "id":  1,
                       "type":  "timeseries",
                       "title":  "Prometheus Scrape Duration",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "scrape_duration_seconds",
                                           "refId":  "A",
                                           "legendFormat":  "{{job}} - {{instance}}"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  0,
                                       "y":  0
                                   },
                       "description":  "How long Prometheus takes to scrape each target.",
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  2,
                       "type":  "timeseries",
                       "title":  "Prometheus Targets Up",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "up",
                                           "refId":  "A",
                                           "legendFormat":  "{{job}} - {{instance}}"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  0
                                   },
                       "description":  "1 is a successful scrape; 0 is an unsuccessful scrape. Not a count of hosts."
                   },
                   {
                       "id":  3,
                       "type":  "stat",
                       "title":  "Healthy Scrape Targets",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum(up)",
                                           "refId":  "A",
                                           "legendFormat":  "Healthy",
                                           "instant":  true
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  6,
                                       "w":  8,
                                       "x":  0,
                                       "y":  9
                                   },
                       "description":  "Number of healthy Prometheus scrape endpoints, not physical servers."
                   },
                   {
                       "id":  4,
                       "type":  "stat",
                       "title":  "Unhealthy Scrape Targets",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "sum(up == bool 0)",
                                           "refId":  "A",
                                           "legendFormat":  "Unhealthy",
                                           "instant":  true
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  6,
                                       "w":  8,
                                       "x":  8,
                                       "y":  9
                                   }
                   },
                   {
                       "id":  18,
                       "type":  "stat",
                       "title":  "Node Exporter Hosts",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "count(count by (instance) (node_uname_info))",
                                           "refId":  "A",
                                           "legendFormat":  "Exporting OS metrics",
                                           "instant":  true
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  6,
                                       "w":  8,
                                       "x":  16,
                                       "y":  9
                                   },
                       "description":  "Unique Node Exporter instances currently exposing OS metrics."
                   },
                   {
                       "id":  6,
                       "type":  "timeseries",
                       "title":  "CPU Usage by Server (%)",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
                                           "refId":  "A",
                                           "legendFormat":  "{{instance}}"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  0,
                                       "y":  24
                                   },
                       "description":  "CPU utilization for every server reporting Node Exporter metrics.",
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "min":  0,
                                                            "max":  100
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  7,
                       "type":  "timeseries",
                       "title":  "Memory Usage by Server (%)",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
                                           "refId":  "A",
                                           "legendFormat":  "{{instance}}"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  24
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "min":  0,
                                                            "max":  100
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  8,
                       "type":  "timeseries",
                       "title":  "Root Disk Usage by Server (%)",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "label_replace((label_replace((label_replace((100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})), \"host\", \"On-prem Gateway\", \"instance\", \"(10[.]30[.]0[.]1|10[.]40[.]0[.]2):9100\")), \"host\", \"On-prem Linux\", \"instance\", \"10[.]30[.]0[.]10:9100\")), \"host\", \"On-prem Security\", \"instance\", \"10[.]30[.]0[.]20:9100\")",
                                           "legendFormat":  "{{host}}"
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  0,
                                       "y":  33
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "min":  0,
                                                            "max":  100
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
                       "id":  9,
                       "type":  "stat",
                       "title":  "On-Premises Server Availability",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "targets":  [
                                       {
                                           "expr":  "up{environment=\"on-premises\"}",
                                           "refId":  "A",
                                           "legendFormat":  "{{host}}",
                                           "instant":  true
                                       }
                                   ],
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  33
                                   },
                       "description":  "1 means the scrape succeeds; 0 means it fails.",
                       "options":  {
                                       "reduceOptions":  {
                                                             "values":  false,
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ]
                                                         },
                                       "colorMode":  "value",
                                       "graphMode":  "none",
                                       "justifyMode":  "auto",
                                       "orientation":  "auto",
                                       "textMode":  "value_and_name"
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "min":  0,
                                                            "max":  1,
                                                            "mappings":  [
                                                                             {
                                                                                 "type":  "value",
                                                                                 "options":  {
                                                                                                 "0":  {
                                                                                                           "text":  "DOWN",
                                                                                                           "color":  "red"
                                                                                                       },
                                                                                                 "1":  {
                                                                                                           "text":  "UP",
                                                                                                           "color":  "green"
                                                                                                       }
                                                                                             }
                                                                             }
                                                                         ],
                                                            "thresholds":  {
                                                                               "mode":  "absolute",
                                                                               "steps":  [
                                                                                             {
                                                                                                 "color":  "red",
                                                                                                 "value":  null
                                                                                             },
                                                                                             {
                                                                                                 "color":  "green",
                                                                                                 "value":  1
                                                                                             }
                                                                                         ]
                                                                           }
                                                        },
                                           "overrides":  [

                                                         ]
                                       }
                   },
                   {
